# -----------------------------------------------------------------------------
# Variables de entorno de Univalle Shop.
# Copia este archivo como .env y ajusta los valores. El archivo .env no se sube
# al repositorio porque puede contener secretos.
# -----------------------------------------------------------------------------

# Secreto con el que el servicio de Usuarios firma los JWT y el Gateway los valida.
# En producción debe ser un valor largo y aleatorio.
JWT_SECRET=cambia-este-secreto-en-produccion

# Tiempo de vida del token de acceso, en segundos (3600 = 1 hora).
JWT_EXPIRES_IN_SECONDS=3600

# Dominios de correo aceptados para registrarse, separados por coma.
# Solo quienes tengan un correo de estos dominios pueden crear una cuenta.
ALLOWED_EMAIL_DOMAINS=correounivalle.edu.co,univalle.edu.co

# Cuenta administradora que se crea al arrancar el servicio de Usuarios si no
# existe. Puede publicar productos y gestionar pedidos. Si ADMIN_EMAIL queda
# vacío, no se crea ninguna. La contraseña necesita 8+ caracteres con letras y números.
ADMIN_NAME=Administrador Univalle Shop
ADMIN_EMAIL=admin@univalleshop.local
ADMIN_PASSWORD=Admin12345

# Si es true, el Catálogo carga categorías y productos de ejemplo cuando está vacío.
SEED_DEMO_DATA=true

# Puerto por el que se publica el API Gateway en la máquina anfitriona.
GATEWAY_PORT=3000

# Puerto por el que se publica el frontend en la máquina anfitriona.
FRONTEND_PORT=8080

# Puerto de la interfaz web de MailHog (bandeja de correos de prueba).
MAILHOG_UI_PORT=8025
